# ==========================================
# Configuración de Base de Datos (BiblioTeca)
# ==========================================
#
# La conexión se configura de forma condicional:
# - Si se configuran TURSO_DATABASE_URL y TURSO_AUTH_TOKEN, la aplicación y los scripts
#   se conectan a Turso remoto usando @libsql/client y Drizzle en modo Turso.
# - Si se dejan vacíos o no existen, la aplicación utiliza SQLite local mediante better-sqlite3.

# Variables de conexión a Turso (remoto)
TURSO_DATABASE_URL=libsql://tu-base-de-datos-usuario.turso.io
TURSO_AUTH_TOKEN=tu-token-de-autenticacion-turso

# Ruta opcional de la base de datos SQLite local (por defecto: ./desarrollo.sqlite)
SQLITE_DATABASE_PATH=./desarrollo.sqlite
